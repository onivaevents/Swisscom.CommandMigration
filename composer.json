{
    "description": "Neos Flow package for framework based CLI command migrations",
    "type": "neos-package",
    "name": "swisscom/commandmigration",
    "license": "MIT",
    "require": {
        "neos/flow": "^8.0 || ^9.0",
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Swisscom\\CommandMigration\\": "Classes/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Swisscom.CommandMigration"
        },
        "applied-flow-migrations": [
            "Neos.Flow-20180415105700",
            "Neos.Flow-20190425144900",
            "Neos.Flow-20190515215000",
            "Neos.Flow-20200813181400",
            "Neos.Flow-20201003165200",
            "Neos.Flow-20201109224100",
            "Neos.Flow-20201205172733",
            "Neos.Flow-20201207104500",
            "Neos.Form-20161124205254",
            "Neos.Flow-20220318174300"
        ]
    },
    "scripts": {
        "fix:code-style": [
            "phpcbf --extensions=php --colors --standard=PSR12 ./Classes"
        ],
        "fix": [
            "@install",
            "@fix:code-style"
        ],
        "lint:code-style": [
            "phpcs --extensions=php --colors --standard=PSR12 --exclude=Generic.Files.LineLength ./Classes"
        ],
        "lint:static-analysis": "phpstan analyse -v",
        "lint": [
            "@install",
            "@lint:code-style",
            "@lint:static-analysis"
        ],
        "test:unit": "vendor/bin/phpunit Tests/Unit",
        "test": [
            "@install",
            "@test:unit"
        ]
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    }
}
